# ============================================================================
# Inkloom — environment contract
# ============================================================================
# Copy to `.env` for local development:   cp .env.example .env
# `.env` is gitignored. NEVER commit real secrets.
#
# In staging/production these are NOT read from a file. Non-secret values live
# in wrangler.jsonc `vars`; every secret is set with `wrangler secret put NAME`
# and stored in Cloudflare Secrets. See docs/ENVIRONMENT.md.
# ============================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
# One of: development | staging | production. Controls cookie security,
# error verbosity, and which safety rails are armed.
INKLOOM_ENV=development

# Public origin of the app. Used for absolute links in email, for strict
# origin/CSRF validation, and for canonical/OG URLs. No trailing slash.
APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Local: the Docker Compose Postgres in compose.yaml (loopback-bound, port 5433).
# Production: a Neon pooled connection string, set as a Cloudflare secret.
DATABASE_URL=postgresql://inkloom:inkloom_local_dev@127.0.0.1:5433/inkloom

# Separate database used only by the integration + concurrency test suites.
# Created automatically by scripts/sql/00-init-test-db.sql on first volume init.
TEST_DATABASE_URL=postgresql://inkloom:inkloom_local_dev@127.0.0.1:5433/inkloom_test

# ---------------------------------------------------------------------------
# Authentication (Better Auth)
# ---------------------------------------------------------------------------
# SECRET. Generate with: openssl rand -base64 32
# Rotating this invalidates every session and every signed token. See
# docs/SECURITY.md "Secret rotation".
BETTER_AUTH_SECRET=dev-only-insecure-secret-replace-me-0000000000
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth — optional. Leave blank to disable the provider entirely;
# the sign-in button is hidden when these are absent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Access codes
# ---------------------------------------------------------------------------
# SECRET. Server-side pepper for the keyed HMAC that fingerprints access codes.
# Redeemable codes are NEVER stored in plaintext — only HMAC-SHA256(code, pepper).
# Rotating this invalidates every existing campaign fingerprint; see
# docs/SECURITY.md before rotating.
ACCESS_CODE_PEPPER=dev-only-insecure-pepper-replace-me-000000

# ---------------------------------------------------------------------------
# Abuse-monitoring pseudonymisation
# ---------------------------------------------------------------------------
# SECRET. Pepper for the rotating keyed hash applied to IP addresses before
# storage. Raw IPs are never written to the database.
IP_HASH_PEPPER=dev-only-insecure-ip-pepper-replace-me-00

# ---------------------------------------------------------------------------
# Email (Resend in staging/production, Mailpit locally)
# ---------------------------------------------------------------------------
# One of: mailpit | resend | console
#
#   mailpit  Delivers to the local fake inbox at http://localhost:8025 and
#            NOWHERE ELSE. Nothing reaches a real address, whatever you type
#            into the signup form. This is the default so development cannot
#            email real people by accident.
#   resend   Delivers for real, over HTTPS. Allowed locally as well as in
#            staging and production.
#   console  Records what would have been sent, in memory. Used by tests.
#
# Verify whichever you choose actually delivers, before trusting signup:
#     pnpm email:test --to you@example.com
EMAIL_TRANSPORT=mailpit
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025

# SECRET in staging/production. Get one free at https://resend.com/api-keys
RESEND_API_KEY=

# Resend will REJECT any From whose domain you have not verified on your
# account. Until you verify a domain, use onboarding@resend.dev — which can
# only deliver to the address that owns the Resend account:
#     EMAIL_FROM="Inkloom <onboarding@resend.dev>"
EMAIL_FROM="Inkloom <no-reply@mail.inkloom.com>"
EMAIL_REPLY_TO=support@inkloom.com
SUPPORT_EMAIL=support@inkloom.com

# ---------------------------------------------------------------------------
# Cloudflare Turnstile
# ---------------------------------------------------------------------------
# Local defaults are Cloudflare's official always-passing test keys, so signup
# works offline without a real Turnstile site. Replace in staging/production.
# Test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# SECRET in staging/production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Set to "false" to hard-disable Turnstile locally (never in production).
TURNSTILE_ENABLED=true

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
# Leave blank locally to disable Sentry entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# Emitted with every structured log line and error report.
INKLOOM_RELEASE=dev

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Product events are stored first-party in Postgres. This only gates whether
# the client beacon is active at all.
ANALYTICS_ENABLED=true

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# All limits are overridable at runtime from /admin/settings; these are the
# boot defaults used before any override row exists.
RATE_LIMIT_ENABLED=true
