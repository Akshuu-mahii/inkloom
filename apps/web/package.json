    "react-router": "^8",
    "@inkloom/api": "workspace:*",
    "@inkloom/core": "workspace:*",
    "@inkloom/db": "workspace:*",
    "zod": "^4.5.4",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11"
  },
  "devDependencies": {
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
