{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inkloom",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  // `nodejs_compat` is what lets the `pg` driver run in workerd, so the same
  // database code path serves local development, tests and production.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./build/client",
    // The Worker runs first and forwards everything it does not serve as a
    // static file, so /api/* and SSR both reach the handler.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none",
  },

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  /*
   * Run the Worker near the DATABASE, not near the visitor.
   *
   * A signed-in page makes several sequential queries and each one pays the full
   * round trip between the edge and Neon. Measured on staging with the Worker at
   * Mumbai and the database in Singapore (~70ms apart): authenticated pages
   * averaged 837ms, marketing pages 49ms. That gap is round trips, not compute.
   * Running the Worker beside the database turns N round trips into one.
   *
   * A PINNED REGION, not `mode: "smart"`, and that is a measured decision rather
   * than a preference. Smart mode was deployed first and did nothing: the
   * response header stayed `cf-placement: local-BOM` and authenticated latency
   * did not move. Smart Placement needs sustained traffic before it will make a
   * decision, and this application serves tens of requests an hour — it would
   * have sat un-relocated indefinitely while appearing to be configured. The
   * pinned region reported `cf-placement: remote-SIN` on the very next deploy.
   *
   * The cost is real and was measured too: public pages went from ~92ms to
   * ~190ms at p50, because they now pay a hop to Singapore for work that barely
   * touches the database. That is the trade — it is worth it only while the
   * signed-in experience dominates, and it should be re-measured if that stops
   * being true.
   *
   * THIS MUST TRACK THE NEON REGION. If the database moves, this becomes
   * silently wrong: still valid, still deployed, just slow again with nothing to
   * say why. `cf-placement` in any response header is how to check it.
   */
  "placement": { "region": "aws:ap-southeast-1" },

  /*
   * Retention sweep.
   *
   * 03:20 UTC daily — off the hour, because every cron on the platform fires at
   * :00 and a sweep has no reason to queue behind them. Nothing else enforces
   * the retention periods published at /privacy, so if this trigger is missing
   * the policy is simply not kept.
   *
   * Cron triggers are per-environment in Cloudflare and are NOT inherited from
   * this top-level block, which is why staging and production each declare
   * their own below.
   */
  "triggers": { "crons": ["20 3 * * *"] },

  // Hyperdrive pools Postgres connections at Cloudflare's edge.
  //
  // It is used in EVERY environment, not just production, for one specific
  // reason: a Worker isolate cannot safely reuse a raw socket across request
  // contexts, so a cached `pg` pool eventually serves a dead connection and
  // queries start timing out. Hyperdrive owns the pooling, so the Worker gets a
  // usable connection every time.
  //
  // Locally, `localConnectionString` points Wrangler straight at the Docker
  // Postgres, so dev and production run the identical code path. The staging
  // and production entries below carry real Hyperdrive ids pointing at separate
  // Neon branches.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "inkloom-local-dev",
      "localConnectionString": "postgresql://inkloom:inkloom_local_dev@127.0.0.1:5433/inkloom",
    },
  ],

  // ---------------------------------------------------------------------
  // NON-SECRET values only.
  //
  // Every secret is set with `wrangler secret put NAME --env <env>` and lives
  // in Cloudflare Secrets, never in this file:
  //   BETTER_AUTH_SECRET, ACCESS_CODE_PEPPER, IP_HASH_PEPPER,
  //   RESEND_API_KEY, TURNSTILE_SECRET_KEY, GOOGLE_CLIENT_SECRET
  // The Hyperdrive binding carries the database credentials, so DATABASE_URL
  // is not set here either.
  // ---------------------------------------------------------------------
  "vars": {
    "INKLOOM_ENV": "development",
    "APP_URL": "http://localhost:5173",
    "EMAIL_TRANSPORT": "mailpit",
    "MAILPIT_HOST": "127.0.0.1",
    "EMAIL_FROM": "Inkloom <no-reply@mail.inkloom.art>",
    "EMAIL_REPLY_TO": "support@inkloom.art",
    "SUPPORT_EMAIL": "support@inkloom.art",
    // ADMIN_PATH and OWNER_EMAIL are deployment secrets set with
    // `wrangler secret put`, NOT here. ADMIN_PATH must ALSO be present in the
    // build environment — the route table bakes it in so the console's links
    // are correct. See docs/DEPLOYMENT.md.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_ENABLED": "true",
    "RATE_LIMIT_ENABLED": "true",
    "ANALYTICS_ENABLED": "true",
    "LOG_LEVEL": "debug",
    "INKLOOM_RELEASE": "dev",
  },

  "env": {
    "staging": {
      "name": "inkloom-staging",
      "vars": {
        "INKLOOM_ENV": "staging",
        "APP_URL": "https://staging.inkloom.art",
        "EMAIL_TRANSPORT": "resend",
        "EMAIL_FROM": "Inkloom (staging) <no-reply@mail-staging.inkloom.art>",
        "EMAIL_REPLY_TO": "support@inkloom.art",
        "SUPPORT_EMAIL": "support@inkloom.art",
        "TURNSTILE_ENABLED": "true",
        // MUST be repeated here. `env.*.vars` REPLACES the top-level `vars`
        // block rather than merging into it, so anything omitted falls back to
        // its schema default — and the default for this one is "", which renders
        // the widget with an empty sitekey. The form then submits no token while
        // the server still demands one, breaking signup, login, password reset
        // and contact all at once, with nothing in the logs but "captcha failed".
        // loadConfig() now refuses to boot on an empty value for exactly this
        // reason. This is the "inkloom-staging" widget, scoped to the
        // staging.inkloom.art hostname only; production has its own.
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEy5d7NT7jtcSiLg",
        "RATE_LIMIT_ENABLED": "true",
        "ANALYTICS_ENABLED": "true",
        "LOG_LEVEL": "info",
        "SENTRY_ENVIRONMENT": "staging",
        "INKLOOM_RELEASE": "v1.0.0-staging",
      },
      // A SEPARATE Neon branch from production. Sharing one would put real
      // user data in a test environment.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "94340d8d7b7948ccb8ff1f246790fc60" }],
      // Cron triggers are not inherited from the top-level block.
      "triggers": { "crons": ["20 3 * * *"] },
      "routes": [{ "pattern": "staging.inkloom.art", "custom_domain": true }],
    },

    "production": {
      "name": "inkloom-production",
      "vars": {
        "INKLOOM_ENV": "production",
        "APP_URL": "https://inkloom.art",
        "EMAIL_TRANSPORT": "resend",
        "EMAIL_FROM": "Inkloom <no-reply@mail.inkloom.art>",
        "EMAIL_REPLY_TO": "support@inkloom.art",
        "SUPPORT_EMAIL": "support@inkloom.art",
        "TURNSTILE_ENABLED": "true",
        // See the note in the staging block: this must be repeated per
        // environment, and an empty value silently breaks every form.
        "TURNSTILE_SITE_KEY": "",
        "RATE_LIMIT_ENABLED": "true",
        "ANALYTICS_ENABLED": "true",
        "LOG_LEVEL": "info",
        "SENTRY_ENVIRONMENT": "production",
        "INKLOOM_RELEASE": "v1.0.0",
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "4fc8b31d98b642539478843fb51e677c" }],
      // Cron triggers are not inherited from the top-level block.
      "triggers": { "crons": ["20 3 * * *"] },
      "routes": [{ "pattern": "inkloom.art", "custom_domain": true }],
    },
  },
}
